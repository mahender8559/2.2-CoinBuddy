{
  "id": "coin-buddy-pwa",
  "name": "Coin Buddy",
  "short_name": "CoinBuddy",
  "description": "Your secure local-first personal finance app with SQLite database ledger.",
  "start_url": "/",
  "scope": "/",
  "lang": "en-US",
  "dir": "ltr",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "categories": [
    "finance",
    "utilities",
    "productivity"
  ],
  "iarc_rating_id": "e84b3e5e-3153-4876-8090-f2c9749ebc90",
  "prefer_related_applications": false,
  "related_applications": [],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/?action=new-note"
  },
  "protocol_handlers": [
    {
      "protocol": "web+coinbuddy",
      "url": "/?action=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "Add Transaction",
      "short_name": "Add Tx",
      "description": "Quickly log a new transaction",
      "url": "/?action=add-tx",
      "icons": [
        {
          "src": "/logo.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "View Accounts",
      "short_name": "Accounts",
      "description": "View all asset & liability accounts",
      "url": "/?action=accounts",
      "icons": [
        {
          "src": "/logo.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/csv": [".csv"],
        "application/json": [".json"]
      }
    }
  ],
  "share_target": {
    "action": "/share-target/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "scope_extensions": [
    {
      "origin": "*.coinbuddy.app"
    }
  ],
  "widgets": [
    {
      "name": "Balance Overview",
      "short_name": "Balance",
      "description": "View current asset and liability balances",
      "tag": "balance-widget",
      "template": "widget-template",
      "ms_ac_template": "widget.json",
      "data": "widget-data.json",
      "type": "text/html",
      "screenshots": [
        {
          "src": "/logo.png",
          "sizes": "512x512",
          "label": "Widget Preview"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/logo.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/logo.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
